# ---------- Obligatorio ----------
# Supabase › Project settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # o la "anon key" antigua en NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=sb_secret_xxx                         # o la "service_role" antigua en SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Motor ----------
# Sin estas dos claves la app funciona en modo demo (reunión de ejemplo) pero no procesa audio real.
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPGRAM_API_KEY=xxx
# EXTRACTION_MODEL=claude-opus-5-5     # claude-sonnet-5-5 cuesta la mitad
# DEEPGRAM_MODEL=nova-3

# ---------- Cola de trabajos ----------
# En local: `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest` y nada más.
# Si no quieres levantar Inngest, PROCESS_INLINE=true procesa en el mismo servidor tras responder.
# En producción (Vercel + Inngest Cloud) pon las dos claves de Inngest.
# PROCESS_INLINE=true
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---------- Correo (opcional: sin esto, Copiar / Gmail / Outlook siguen funcionando) ----------
RESEND_API_KEY=re_xxx
EMAIL_FROM=avisos@tudominio.com

# ---------- Cobro (opcional en local) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx          # precio recurrente mensual del plan Pro

# ---------- Cron de borrado de audio ----------
CRON_SECRET=una-cadena-larga-aleatoria

# ---------- Marca ----------
# NEXT_PUBLIC_PRODUCT_NAME=Acta
